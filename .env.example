# ==== API Python (jangan pernah commit nilai asli) ====
# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rahasia JWT (buat acak panjang, mis. openssl rand -hex 32)
JWT_SECRET=ganti-dengan-rahasia-acak-panjang

# Origin yang boleh mengakses API (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:5173,https://USERNAME.github.io

# Umur data di Redis dalam detik (default 30 hari)
DATA_TTL_SECONDS=2592000

# ==== Frontend (aman diekspos) ====
VITE_API_BASE_URL=http://localhost:8000
# Untuk GitHub Pages isi dengan "/nama-repo/"
VITE_BASE_PATH=/

# ==== Seed admin pertama ====
BOOTSTRAP_ADMIN_EMAIL=admin@lbtdes26.com
BOOTSTRAP_ADMIN_PASSWORD=acakajakali123
BOOTSTRAP_ADMIN_NAME=Admin LBT

# ==== Seed koordinator tim ====
BOOTSTRAP_COORDINATOR_EMAIL=koordinator@lbtdes26.com
BOOTSTRAP_COORDINATOR_PASSWORD=acakajakali123
BOOTSTRAP_COORDINATOR_NAME=Koordinator Tim
